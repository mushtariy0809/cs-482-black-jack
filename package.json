{
  "name": "21-club-mushtariy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:memory": "node scripts/dev.js --memory",
    "dev:frontend": "vite --host 127.0.0.1",
    "dev:backend": "npm --prefix backend run dev",
    "build": "vite build",
    "test": "npm run test:logic && npm run test:backend && npm run test:ui",
    "test:logic": "node --experimental-test-coverage --test src/blackjack.test.js src/tests/*.test.js src/tutorial/riggedDeck.test.js",
    "test:backend": "npm --prefix backend test",
    "test:ui": "vitest run",
    "postinstall": "npm --prefix backend install"
  },
  "dependencies": {
    "framer-motion": "^14.9.0",
    "howler": "^2.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "jsdom": "^26.1.0",
    "vite": "^6.1.0",
    "vitest": "^4.1.12"
  }
}
